DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Optional. Gemini is the only provider with an env/secrets fallback - an
# explicit, opt-in exception (see session_keys.py). If set, anyone using this
# deployment who doesn't enter their own Gemini key will use this one instead
# (their generation, your billing). OpenAI/Anthropic have no such fallback:
# every visitor must always enter their own key for those.
# GEMINI_API_KEY="your-key-here"
